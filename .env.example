# LINE Bot 設定
# LINE Developers (developers.line.biz) → 你的 channel → Basic settings
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Developers → 你的 channel → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 你自己的 LINE user ID（傳訊息給 bot 後，webhook log 裡的 userId 欄位）
LINE_USER_ID=your_line_user_id_here

# Pexels API key（免費申請：pexels.com/api）
PEXELS_API_KEY=your_pexels_api_key_here

# GitHub token（github.com/settings/tokens → Generate token → 勾 repo 權限）
GITHUB_TOKEN=your_github_token_here

# 影片上傳的目標 repo（格式：username/repo-name）
GITHUB_REPO=your_username/your_repo_name
